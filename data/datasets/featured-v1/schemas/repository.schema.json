  "type": "object",
  "required": [
    "repository_id",
    "full_name",
    "html_url"
  ],
  "properties": {
    "repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "full_name": {
      "type": "string"
    },
    "html_url": {
      "type": "string"
    }
  }
}
